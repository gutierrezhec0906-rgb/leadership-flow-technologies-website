# Copy this file to .env.local and fill in real values before deploying.

# Public site URL used for canonical links, sitemap.xml, robots.txt and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.leadership-flow.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# Calendly scheduling link used for the "Book a Demo" embed. Leave blank to show a placeholder CTA instead.
NEXT_PUBLIC_CALENDLY_URL=

# Zoho Mail SMTP — used by the Contact form and newsletter signup API routes
# to actually send email. Without these, both forms will return an error
# instead of silently failing.
#
# ZOHO_EMAIL: the Zoho mailbox that sends the notification (e.g. Hectorg@accountability-app.com)
# ZOHO_APP_PASSWORD: an app-specific password — do NOT use your normal Zoho login password.
#   Generate one at: Zoho Mail > Settings > Security > App Passwords
# ZOHO_SMTP_HOST: only needed if your account is on a non-default Zoho data center
#   (e.g. smtp.zoho.eu, smtp.zoho.in). Leave unset for smtp.zoho.com.
# CONTACT_TO_EMAIL: where form submissions are delivered. Defaults to ZOHO_EMAIL if unset.
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
ZOHO_SMTP_HOST=
CONTACT_TO_EMAIL=
